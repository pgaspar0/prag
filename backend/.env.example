# Environment
ENV=development

# Database
# For local Docker:
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5433/prag_db
DATABASE_URL_SYNC=postgresql://postgres:postgrespassword@localhost:5433/prag_db

# For Neon production (disable statement cache for pgbouncer):
# DATABASE_URL=postgresql+asyncpg://[user]:[password]@[endpoint]-pooler.neon.tech/neondb?ssl=require
# DATABASE_URL_SYNC=postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/neondb?sslmode=require

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEN_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
SIM_THRESHOLD=0.55

# Storage
STORAGE_DIR=backend/storage
# R2 (Production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Security
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MAX_UPLOAD_SIZE_MB=10
MAX_PAGES=30
DAILY_LLM_CAP=400
SENTRY_DSN=
